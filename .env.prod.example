# Production settings for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Anything marked required has no default on purpose: the stack refuses to
# start rather than run with a guessed value.

# --- required -----------------------------------------------------------

POSTGRES_USER=stegwerk
POSTGRES_PASSWORD=
POSTGRES_DB=stegwerk

# Sign tokens with something long and random, and keep it. Changing it signs
# everyone out; leaking it lets anyone mint a session as anyone.
#   openssl rand -base64 48
JWT_SECRET=

# The address people actually type. Every invitation and password-reset link
# is built from this, so a wrong value produces mail that leads nowhere.
WEB_ORIGIN=https://app.ihre-domain.de

# Encrypts the passwords of the mailboxes people connect for inbound mail.
# Without it, storing one is refused outright rather than kept in the clear —
# so the mailbox screen simply will not accept anything, with no other hint
# that a key is missing.
#   openssl rand -base64 32
MAIL_ENCRYPTION_KEY=
# Fuer die Zwei-Faktor-Anmeldung: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
# Nur beim Rotieren: die alten Schluessel, die noch lesen duerfen
# (docs/schluesselrotation.md). Sonst leer lassen.
MAIL_ENCRYPTION_KEY_ALT=
TOTP_ENCRYPTION_KEY_ALT=
# Wer die Betreiber-Seite (Mehr -> Betrieb) sieht: die eigene Anmeldeadresse,
# mehrere durch Kommas. Das Konto braucht ausserdem die Zwei-Faktor-Anmeldung.
BETREIBER_EMAILS=

# --- outbound mail ------------------------------------------------------
# Without SMTP_HOST, invitations and password resets are written to a volume
# instead of being sent. Nobody receives them.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@ihre-domain.de
MAIL_FROM_NAME=Stegwerk

# --- Google und Microsoft ------------------------------------------------
# Anmelden mit Google/Microsoft (docs/anmelden-microsoft-google.md) und
# Postfach/Kalender ueber Google/Microsoft (docs/oauth.md). Ein Anbieter
# erscheint nur, wenn Client-ID UND Geheimnis gesetzt sind. Rueckrufadressen:
#   <OAUTH_REDIRECT_ORIGIN>/oauth/anmelden/rueckruf  (Anmelden)
#   <OAUTH_REDIRECT_ORIGIN>/oauth/rueckruf           (Postfach und Kalender)
# Leer: es gilt WEB_ORIGIN.

OAUTH_REDIRECT_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (Firmen- und private Konten), organizations (nur Firmenkonten)
# oder die Mandanten-ID des eigenen Unternehmens
MICROSOFT_TENANT=common

# --- optional -----------------------------------------------------------

WEB_PORT=127.0.0.1:8080
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Use an EU-region project (ingest.de.sentry.io); see docs/rechtliches.md. The web DSN is
# compiled into the bundle, so changing it needs a rebuild.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_PROFESSIONAL_MONTH=
STRIPE_PRICE_PROFESSIONAL_YEAR=

# --- Impressum, §5 TMG --------------------------------------------------
# Shown on a page reachable without an account. Leaving these empty is a
# missing legal notice, not a cosmetic gap.

LEGAL_COMPANY_NAME=
LEGAL_FORM=
LEGAL_STREET=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_REPRESENTATIVE=
LEGAL_REGISTER_ENTRY=
LEGAL_VAT_ID=
