NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://weitblick:weitblick@localhost:5433/weitblick

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

WEB_ORIGIN=http://localhost:5273

# Billing. Leave empty to run without paid plans: workspaces stay on the
# free trial and the upgrade screen explains that billing is not configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_PROFESSIONAL_MONTH=
STRIPE_PRICE_PROFESSIONAL_YEAR=

# Impressum, required of German commercial sites by §5 TMG. Leave empty and
# the Impressum page says it is not configured rather than showing blanks.
LEGAL_COMPANY_NAME=
LEGAL_FORM=
LEGAL_STREET=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_REPRESENTATIVE=
LEGAL_REGISTER_ENTRY=
LEGAL_VAT_ID=

# Error tracking. Empty means off, and the server says so at boot.
# Use an EU-region DSN (https://<key>@o<org>.ingest.de.sentry.io/<project>)
# to keep error data inside the EU; see docs/rechtliches.md.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Outbound email. With no SMTP_HOST, messages are written to server/var/mail
# as .eml files instead of being sent — enough to develop against, never
# enough to ship.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@example.de
MAIL_FROM_NAME=Stegwerk

# How long a workspace's data is kept after its access ends — a lapsed trial,
# a cancellation, or an unpaid invoice past its grace period. Art. 5(1)(e)
# says data may not be kept longer than the purpose needs, and this number is
# your answer to that. Whatever you set has to match your privacy policy.
RETENTION_DAYS=90

# Nothing is deleted unless this is true. Off by default on purpose: a process
# that destroys customer records on a timer should not start because somebody
# deployed a new version. Use previewRetention first to see what it would do.
RETENTION_SWEEP_ENABLED=false

# Der Schlüssel, mit dem die Zugangsdaten verbundener Postfächer versiegelt
# werden. Ohne ihn verweigert der Server das Speichern eines Postfachs, statt
# ein fremdes Passwort im Klartext abzulegen.
# Erzeugen mit: openssl rand -base64 32
MAIL_ENCRYPTION_KEY=
# Nur beim Rotieren: der alte Schlüssel (mehrere durch Komma), der noch lesen
# darf, bis `npm run umschluesseln` alles neu versiegelt hat.
# Ablauf: docs/schluesselrotation.md
MAIL_ENCRYPTION_KEY_ALT=

# Postfach und Kalender über Google oder Microsoft verbinden (OAuth), und
# Anmelden mit Google oder Microsoft. Leer lassen: dann gibt es nur IMAP/SMTP
# und CalDAV mit App-Passwort und nur die Anmeldung mit Passwort.
# Rückrufadressen, die bei Google und Microsoft eingetragen werden:
#   <OAUTH_REDIRECT_ORIGIN>/oauth/rueckruf, z. B. https://crm.example.com/oauth/rueckruf
#   <OAUTH_REDIRECT_ORIGIN>/oauth/anmelden/rueckruf (Anmelden, docs/anmelden-microsoft-google.md)
# Ohne OAUTH_REDIRECT_ORIGIN gilt WEB_ORIGIN (nginx reicht /oauth an den Server).
# Lokal mit Vite auf 5273 und der API auf 4000: http://localhost:4000
# Einrichtung Schritt für Schritt: docs/oauth.md
OAUTH_REDIRECT_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (alle Konten), organizations (nur Firmenkonten) oder die Mandanten-ID
MICROSOFT_TENANT=common

# Das CA-Zertifikat der Datenbank, wenn sie nicht im selben Netz steht.
# Leer lassen, solange sie es tut — dann entscheidet DATABASE_URL allein.
# PEM wie heruntergeladen, oder dasselbe base64-kodiert.
# Siehe docs/hosting.md, "Moving the database somewhere that does not expire".
DATABASE_CA_CERT=

# Weitere Ursprünge, die der Browser anrufen darf (durch Leerzeichen getrennt).
# Nur nötig, wenn die Oberfläche an eine andere Meldestelle berichtet als der
# Server — VITE_SENTRY_DSN wird beim Bauen eingebacken, dieser Prozess kennt
# sie nicht. Siehe docs/hosting.md, "The headers the browser is sent".
CSP_CONNECT_SRC=

# Angaben für die Datenschutzerklärung unter /datenschutz.
#
# Was die Anwendung verarbeitet, leitet die Seite selbst aus dieser Umgebung
# ab — welche Dienste eingerichtet sind, wie lange aufbewahrt wird. Was sie
# nicht wissen kann, steht hier. Fehlt eines davon, zeigt die Seite an dieser
# Stelle eine sichtbare Lücke statt eines Satzes, der nach Vollständigkeit
# klingt.
LEGAL_HOSTING=
LEGAL_PRIVACY_CONTACT=
LEGAL_SUPERVISORY_AUTHORITY=

# Auf true setzen, wenn jemand mit der nötigen Sachkunde den Text freigegeben
# hat. Vorher trägt die Seite sichtbar den Hinweis, dass sie ungeprüft ist —
# und das soll sie, denn ein ungeprüfter Text, der aussieht wie ein geprüfter,
# erzeugt genau das Vertrauen, das er nicht verdient.
LEGAL_PRIVACY_REVIEWED=false

# Wie gesichert wird — in Worten des Betreibers, für Anlage 2 des
# Auftragsverarbeitungsvertrags. Wie oft, wie lange aufbewahrt, wann die
# Wiederherstellung zuletzt tatsächlich erprobt wurde. Bleibt das leer, weist
# der Vertrag an dieser Stelle eine Lücke aus — was richtig ist, solange die
# Antwort niemand kennt. Eine erfundene Sicherung wäre hier eine vertragliche
# Zusage über etwas, das es möglicherweise nicht gibt.
LEGAL_BACKUP_DESCRIPTION=

# Auf true setzen, wenn der Vertrag anwaltlich geprüft ist. Getrennt von
# LEGAL_PRIVACY_REVIEWED: wer die Datenschutzerklärung prüfen ließ, hat damit
# nicht den Vertrag geprüft, und für den haftet, wer unterschreibt.
LEGAL_DPA_REVIEWED=false

# Der Schlüssel, mit dem die Geheimnisse der Zwei-Faktor-Anmeldung versiegelt
# werden. Ein eigener und nicht der für Postfächer: getrennte Zwecke bekommen
# getrennte Schlüssel, und MAIL_ENCRYPTION_KEY würde dem Namen nach lügen.
# Fehlt er, lässt sich die Zwei-Faktor-Anmeldung nicht einschalten — sie wird
# verweigert, statt das Geheimnis im Klartext abzulegen.
# Erzeugen mit: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY_ALT=
